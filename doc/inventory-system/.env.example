# ============================================================
# inventory-system 环境变量示例
# 复制为 .env 后填写真实值，永远不要提交 .env 文件！
# ============================================================

# ============================================================
# Backend (Go) - Vercel Serverless / 本地开发
# ============================================================

# Supabase PostgreSQL 数据库
SUPABASE_HOST=your-project-ref.supabase.co
SUPABASE_PORT=5432
SUPABASE_USER=postgres
SUPABASE_PASSWORD=your-supabase-password
SUPABASE_DB_NAME=postgres
SUPABASE_JWT_SECRET=your-jwt-secret-at-least-32-characters

# 阿里云 OSS
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET_NAME=your-bucket-name
OSS_BUCKET_DOMAIN=https://your-bucket.oss-cn-hangzhou.aliyuncs.com

# 本地 MySQL 开发配置（可选，仅在本地 config.yaml 中使用）
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=your-local-mysql-password
DATABASE_NAME=inventory_db

# JWT 本地开发密钥
JWT_SECRET=your-local-jwt-secret-at-least-32-characters

# 服务器端口（Vercel 会自动提供 PORT 环境变量）
# PORT=8080

# ============================================================
# Frontend (Next.js)
# ============================================================

# 后端 API 地址（Vercel 部署时填写真实后端域名）
NEXT_PUBLIC_API_URL=https://your-backend-domain.vercel.app/api/v1

# OSS 公开访问地址（用于前端直接访问图片）
NEXT_PUBLIC_OSS_URL=https://your-bucket.oss-cn-hangzhou.aliyuncs.com
