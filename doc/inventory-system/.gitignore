# ============================================================
# inventory-system 根目录 .gitignore
# ============================================================

# --- dependencies ---
node_modules/

# --- frontend build ---
frontend/.next/
frontend/out/
frontend/dist/
frontend/.vercel/

# --- backend build & uploads ---
backend/bin/
backend/uploads/
backend/go-server
backend/coverage.out
backend/coverage.html
backend/logs/

# --- env files (all levels) ---
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
backend/.env
backend/.env.*

# --- logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- IDE / OS ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# --- test coverage ---
coverage/
*.tsbuildinfo
